<mxfile host="app.diagrams.net" pages="2">
  <diagram id="schema" name="Schema">
    <mxGraphModel dx="5339" dy="3486" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="word_tokenization" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;" value="Word tokenization&#xa;Whole words: short sequences, but&#xa;a finite vocabulary misses&#xa;unfamiliar words." vertex="1">
          <mxGeometry height="74" width="250" x="-200" y="480" as="geometry" />
        </mxCell>
        <mxCell id="subword_tokenization" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;" value="Sub-word tokenization&#xa;Reuses frequent pieces of words,&#xa;so a modest vocabulary covers&#xa;rare words; used by most LLMs." vertex="1">
          <mxGeometry height="74" width="250" x="-20" y="640" as="geometry" />
        </mxCell>
        <mxCell id="byte_tokenization" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;" value="Byte tokenization&#xa;UTF-8 bytes: 256 values cover any&#xa;text, at the cost of longer&#xa;sequences." vertex="1">
          <mxGeometry height="74" width="250" x="250" y="640" as="geometry" />
        </mxCell>
        <mxCell id="language_model" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;shape=process;size=0.06;spacingLeft=22;strokeWidth=3;" value="Language model&#xa;A Transformer that turns token IDs&#xa;into token states and, for&#xa;generation, scores the next token." vertex="1">
          <mxGeometry height="74" width="260" x="1010" y="140" as="geometry" />
        </mxCell>
        <mxCell id="attention" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" value="Attention&#xa;Combines information from the&#xa;positions a token may see. A&#xa;causal mask shows only earlier&#xa;positions; BERT sees both sides." vertex="1">
          <mxGeometry height="89" width="250" x="1360" y="-19" as="geometry" />
        </mxCell>
        <mxCell id="training" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" value="Training&#xa;A loss measures prediction errors;&#xa;optimization updates the embedding&#xa;matrix and the other weights." vertex="1">
          <mxGeometry height="74" width="250" x="1700" y="30" as="geometry" />
        </mxCell>
        <mxCell id="tokenizer" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;strokeWidth=3;" value="Tokenizer&#xa;Splits text into tokens with its&#xa;own rules and maps each token to&#xa;an ID; a model needs the mapping&#xa;it was trained with. Models may&#xa;share a tokenizer." vertex="1">
          <mxGeometry height="104" width="250" x="570" y="50" as="geometry" />
        </mxCell>
        <mxCell id="tokenization" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;" value="Tokenization&#xa;Splitting text into tokens, the&#xa;units a language model reads." vertex="1">
          <mxGeometry height="59" width="250" x="-20" y="270" as="geometry" />
        </mxCell>
        <mxCell id="token" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;strokeWidth=3;" value="Token&#xa;One piece of text: a word, part&#xa;of a word or a byte." vertex="1">
          <mxGeometry height="59" width="250" x="360" y="315" as="geometry" />
        </mxCell>
        <mxCell id="token_id" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;strokeWidth=3;" value="Token ID&#xa;A token&#39;s number in the&#xa;vocabulary. The order of IDs&#xa;matters; the numeric gap between&#xa;two IDs means nothing." vertex="1">
          <mxGeometry height="89" width="250" x="700" y="374" as="geometry" />
        </mxCell>
        <mxCell id="embedding_matrix" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;shape=cylinder3;boundedLbl=1;size=10;spacingTop=14;strokeWidth=3;" value="Embedding matrix&#xa;The model&#39;s table with one learned&#xa;row per vocabulary entry." vertex="1">
          <mxGeometry height="104" width="250" x="1130" y="329" as="geometry" />
        </mxCell>
        <mxCell id="token_embedding" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" value="Token embedding&#xa;The row an ID retrieves from the&#xa;embedding matrix; the same ID&#xa;always retrieves the same row." vertex="1">
          <mxGeometry height="74" width="250" x="1450" y="315" as="geometry" />
        </mxCell>
        <mxCell id="contextualized_embedding" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" value="Contextualized embedding&#xa;One vector per token occurrence,&#xa;after the layers have combined its&#xa;context and position." vertex="1">
          <mxGeometry height="74" width="250" x="1830" y="280" as="geometry" />
        </mxCell>
        <mxCell id="next_token_probabilities" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;" value="Next-token probabilities&#xa;Scores for every possible next&#xa;token; generation picks one,&#xa;appends it and repeats." vertex="1">
          <mxGeometry height="74" width="250" x="2020" y="154" as="geometry" />
        </mxCell>
        <mxCell id="input_text" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;shape=document;boundedLbl=1;size=0.2;" value="Input text&#xa;A sequence of characters." vertex="1">
          <mxGeometry height="60" width="250" x="560" y="654" as="geometry" />
        </mxCell>
        <mxCell id="text_embedding" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" value="Text embedding&#xa;One vector for a sentence or&#xa;passage, made by pooling token&#xa;states or selecting one of them." vertex="1">
          <mxGeometry height="74" width="250" x="1740" y="510" as="geometry" />
        </mxCell>
        <mxCell id="bag_of_words" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;arcSize=6;" value="Bag-of-words&#xa;Counts how often each vocabulary&#xa;entry appears in a text." vertex="1">
          <mxGeometry height="59" width="250" x="800" y="520" as="geometry" />
        </mxCell>
        <mxCell id="bag_of_words_limitation" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;arcSize=6;" value="Bag-of-words limitation&#xa;Loses word order and meaning:&#xa;&quot;Dogs chase cats&quot; and &quot;Cats chase&#xa;dogs&quot; get identical counts." vertex="1">
          <mxGeometry height="74" width="250" x="1000" y="666" as="geometry" />
        </mxCell>
        <mxCell id="embedding" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;strokeWidth=3;" value="Embedding&#xa;A learned vector of numbers that&#xa;represents a token or a text;&#xa;which relationships it captures&#xa;depends on data and objective." vertex="1">
          <mxGeometry height="89" width="250" x="1200" y="505" as="geometry" />
        </mxCell>
        <mxCell id="semantic_similarity" parent="1" style="html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;" value="Semantic similarity&#xa;Cosine similarity of two text&#xa;embeddings from the same model;&#xa;whether high means relevance,&#xa;paraphrase or topic overlap&#xa;depends on training." vertex="1">
          <mxGeometry height="104" width="250" x="1520" y="700" as="geometry" />
        </mxCell>
        <mxCell id="question_subword" parent="1" style="rounded=1;html=0;fontSize=12;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Why do LLMs prefer sub-word tokens?" vertex="1">
          <mxGeometry height="40" width="250" x="-60" y="780" as="geometry" />
        </mxCell>
        <mxCell id="question_swapped_ids" parent="1" style="rounded=1;html=0;fontSize=12;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="What breaks if a tokenizer swaps two IDs?" vertex="1">
          <mxGeometry height="40" width="290" x="480" y="177" as="geometry" />
        </mxCell>
        <mxCell id="question_context" parent="1" style="rounded=1;html=0;fontSize=12;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="How does context change a token&#39;s embedding?" vertex="1">
          <mxGeometry height="40" width="300" x="1425" y="250" as="geometry" />
        </mxCell>
        <mxCell id="question_word_order" parent="1" style="rounded=1;html=0;fontSize=12;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Can counts tell &quot;dogs chase cats&quot; from &quot;cats chase dogs&quot;?" vertex="1">
          <mxGeometry height="40" width="390" x="860" y="780" as="geometry" />
        </mxCell>
