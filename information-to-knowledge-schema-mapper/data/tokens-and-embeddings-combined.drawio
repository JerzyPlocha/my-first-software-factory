  <diagram id="study-guide" name="Study guide">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2050" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="guide_1" value="&lt;b&gt;Study guide: tokens and embeddings&lt;/b&gt;&lt;br&gt;Explanations for each stage of the schema on page 1, then activities to rebuild and challenge it." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="guide_2" value="&lt;b&gt;Choose the units&lt;/b&gt;&lt;br&gt;Whole words give short sequences but a finite&lt;br&gt;vocabulary can miss unfamiliar words." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="380" height="73" as="geometry" />
        </mxCell>
        <mxCell id="guide_3" value="&lt;b&gt;Mechanism&lt;/b&gt;&lt;br&gt;Bytes cover UTF-8 text with 256 possible byte&lt;br&gt;values, often at the cost of longer sequences." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="197" width="380" height="73" as="geometry" />
        </mxCell>
        <mxCell id="guide_4" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;Subword vocabularies reuse frequent pieces.&lt;br&gt;Coverage depends on the tokenizer and its fallback." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="284" width="380" height="73" as="geometry" />
        </mxCell>
        <mxCell id="guide_5" value="&lt;b&gt;Preserve identity and order&lt;/b&gt;&lt;br&gt;Bag-of-words gives one count per vocabulary entry.&lt;br&gt;“Dogs chase cats” and “Cats chase dogs” can have&lt;br&gt;identical counts." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_6" value="&lt;b&gt;Mechanism&lt;/b&gt;&lt;br&gt;A sequence of IDs retains order. Exchanging two IDs&lt;br&gt;changes the sequence. The numeric gap between IDs&lt;br&gt;has no inherent meaning." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="214" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_7" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;A model needs the token-to-ID mapping it was&lt;br&gt;trained with. Special IDs can mark boundaries.&lt;br&gt;Models may share a tokenizer." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="318" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_8" value="&lt;b&gt;Learn from other examples&lt;/b&gt;&lt;br&gt;In 2003 Bengio and colleagues jointly learned word&lt;br&gt;vectors and a predictor. Shared features let&lt;br&gt;related examples inform predictions." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="820" y="110" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_9" value="&lt;b&gt;Mechanism&lt;/b&gt;&lt;br&gt;During training, a loss measures prediction error.&lt;br&gt;Optimization adjusts embedding coordinates and&lt;br&gt;other model parameters." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="820" y="214" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_10" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;During inference, each ID retrieves its stored row.&lt;br&gt;Which relationships appear in vector space depends&lt;br&gt;on the data and objective." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="820" y="318" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_11" value="&lt;b&gt;Choose the context&lt;/b&gt;&lt;br&gt;A single lookup vector cannot distinguish uses of&lt;br&gt;the same token. Surrounding tokens supply evidence&lt;br&gt;about each occurrence." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1220" y="110" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_12" value="&lt;b&gt;Mechanism&lt;/b&gt;&lt;br&gt;A Transformer uses attention to combine information&lt;br&gt;from accessible positions. A causal mask allows&lt;br&gt;only the prefix at each position." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1220" y="214" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_13" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;BERT (Devlin et al., 2019) uses context on both&lt;br&gt;sides. The model architecture determines which&lt;br&gt;clues can affect a token state." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1220" y="318" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_14" value="&lt;b&gt;Choose what to compare&lt;/b&gt;&lt;br&gt;A passage has many token states. To retrieve&lt;br&gt;passages efficiently, represent each passage with a&lt;br&gt;single vector." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1620" y="110" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_15" value="&lt;b&gt;Mechanism&lt;/b&gt;&lt;br&gt;Pool states or select a designated state.&lt;br&gt;Similarity training can favor relevant&lt;br&gt;query–passage pairs over irrelevant pairs." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1620" y="214" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_16" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;Cosine similarity compares vector directions.&lt;br&gt;Whether a high score means relevance, paraphrase,&lt;br&gt;or topic overlap depends on training." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1620" y="318" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_17" value="Rebuild and challenge the map" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="452" width="1180" height="39" as="geometry" />
        </mxCell>
        <mxCell id="guide_18" value="Start with a blank page and the diagram closed. Reopen the overview only after you have drawn your own explanation." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="501" width="1180" height="39" as="geometry" />
        </mxCell>
        <mxCell id="guide_19" value="&lt;b&gt;Recall from scratch&lt;/b&gt;&lt;br&gt;Draw how text becomes useful to a model. Include a branch for generation&lt;br&gt;and a branch for retrieval. Give each arrow a verb." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="20" y="554" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_20" value="&lt;b&gt;Locate one uncertainty&lt;/b&gt;&lt;br&gt;Circle the first arrow you could not explain. Write three questions about&lt;br&gt;its input, its operation and what could make your explanation fail." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="420" y="554" width="380" height="107" as="geometry" />
        </mxCell>
        <mxCell id="guide_21" value="&lt;b&gt;Predict before checking&lt;/b&gt;&lt;br&gt;If two vocabulary IDs are swapped only in the tokenizer, what changes?&lt;br&gt;What other rows or output mappings would need to move to preserve&lt;br&gt;behavior?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="554" width="380" height="124" as="geometry" />
        </mxCell>
        <mxCell id="guide_22" value="&lt;b&gt;Try to break a claim&lt;/b&gt;&lt;br&gt;Find two texts with the same word counts and different meanings. Which&lt;br&gt;representation loses the distinction? Where could it be recovered?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="20" y="692" width="380" height="107" as="geometry" />
        </mxCell>
        <mxCell id="guide_23" value="&lt;b&gt;Explain by analogy&lt;/b&gt;&lt;br&gt;Invent an analogy for the embedding lookup. Name two ways it breaks down&lt;br&gt;when explaining learning or contextualization." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="420" y="692" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide_24" value="&lt;b&gt;Review your strategy&lt;/b&gt;&lt;br&gt;Use the CSV’s 30–120 second struggle target on one missing link. At the&lt;br&gt;15-minute check, mark what you recalled, what you guessed and which arrow&lt;br&gt;to revisit." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="692" width="380" height="124" as="geometry" />
        </mxCell>
        <mxCell id="guide_25" value="Check against the overview. Redraw one corrected relationship from memory and explain what observation would change your answer." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;arcSize=4;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="830" width="1180" height="39" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
