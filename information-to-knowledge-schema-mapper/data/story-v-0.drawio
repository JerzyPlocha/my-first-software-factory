<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="How does text become a representation?" id="page1"><mxGraphModel page="1" pageWidth="1440" pageHeight="810" grid="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="How does text become a representation?" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=35;fontColor=#203747;"><mxGeometry x="45" y="30" width="1340" height="55" as="geometry" /></mxCell><mxCell id="sub" parent="1" vertex="1" value="Read each arrow as a sentence. Follow the blue path to the lookup, then follow the green path to either use of the model." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#203747;"><mxGeometry x="45" y="92" width="1340" height="50" as="geometry" /></mxCell><mxCell id="t" parent="1" vertex="1" value="&lt;b&gt;Input text&lt;/b&gt;&lt;br&gt;A sequence of characters." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="45" y="185" width="255" height="108" as="geometry" /></mxCell><mxCell id="p" parent="1" vertex="1" value="&lt;b&gt;Token pieces&lt;/b&gt;&lt;br&gt;A tokenizer splits text&lt;br&gt;using its rules." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="410" y="185" width="255" height="108" as="geometry" /></mxCell><mxCell id="i" parent="1" vertex="1" value="&lt;b&gt;Token IDs&lt;/b&gt;&lt;br&gt;An ordered sequence of&lt;br&gt;vocabulary entries." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="775" y="185" width="255" height="108" as="geometry" /></mxCell><mxCell id="m" parent="1" vertex="1" value="&lt;b&gt;Embedding matrix&lt;/b&gt;&lt;br&gt;One learned row per entry.&lt;br&gt;Each row is a list of numbers." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="1140" y="185" width="255" height="108" as="geometry" /></mxCell><mxCell id="rank" parent="1" vertex="1" value="&lt;b&gt;Similarity score&lt;/b&gt;&lt;br&gt;Compare vectors from a&lt;br&gt;compatible embedding model." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="45" y="410" width="255" height="108" as="geometry" /></mxCell><mxCell id="sent" parent="1" vertex="1" value="&lt;b&gt;Text embedding&lt;/b&gt;&lt;br&gt;One vector for a passage&lt;br&gt;or a whole sentence." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="410" y="410" width="255" height="108" as="geometry" /></mxCell><mxCell id="ctx" parent="1" vertex="1" value="&lt;b&gt;Contextual token states&lt;/b&gt;&lt;br&gt;One vector per occurrence.&lt;br&gt;Layers combine accessible&lt;br&gt;context and position information." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="775" y="410" width="255" height="108" as="geometry" /></mxCell><mxCell id="raw" parent="1" vertex="1" value="&lt;b&gt;Input token vectors&lt;/b&gt;&lt;br&gt;One lookup per ID. Repeated&lt;br&gt;IDs retrieve the same row." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="1140" y="410" width="255" height="108" as="geometry" /></mxCell><mxCell id="count" parent="1" vertex="1" value="&lt;b&gt;Bag-of-words&lt;/b&gt;&lt;br&gt;Counts per vocabulary entry.&lt;br&gt;Reordering preserves counts." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#eee7fa;strokeColor=#667d88;"><mxGeometry x="45" y="635" width="255" height="108" as="geometry" /></mxCell><mxCell id="sample" parent="1" vertex="1" value="&lt;b&gt;Next token ID&lt;/b&gt;&lt;br&gt;Choose a token, append it,&lt;br&gt;and repeat. Decode IDs to text." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="410" y="635" width="255" height="108" as="geometry" /></mxCell><mxCell id="predict" parent="1" vertex="1" value="&lt;b&gt;Next-token probabilities&lt;/b&gt;&lt;br&gt;A generative model scores&lt;br&gt;possible next tokens." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="775" y="635" width="255" height="108" as="geometry" /></mxCell><mxCell id="train" parent="1" vertex="1" value="&lt;b&gt;Training signal&lt;/b&gt;&lt;br&gt;Prediction errors update the&lt;br&gt;matrix and model weights." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#eee7fa;strokeColor=#667d88;"><mxGeometry x="1140" y="635" width="255" height="108" as="geometry" /></mxCell><mxCell id="t_p" parent="1" edge="1" source="t" target="p" value="splits into" style="endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#45606c;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_i" parent="1" edge="1" source="p" target="i" value="map to" style="endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#45606c;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="i_m" parent="1" edge="1" source="i" target="m" value="index rows in" style="endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#45606c;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m_raw" parent="1" edge="1" source="m" target="raw" value="supplies" style="endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#45606c;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="raw_ctx" parent="1" edge="1" source="raw" target="ctx" value="layers transform" style="endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#45606c;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ctx_sent" parent="1" edge="1" source="ctx" target="sent" value="pool or select¹" style="endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#45606c;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sent_rank" parent="1" edge="1" source="sent" target="rank" value="compare pair" style="endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#45606c;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ctx_predict" parent="1" edge="1" source="ctx" target="predict" value="last state feeds head" style="endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#45606c;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="predict_sample" parent="1" edge="1" source="predict" target="sample" value="sample or select" style="endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#45606c;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t_count" parent="1" edge="1" source="t" target="count" value="" style="endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#79649b;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="239.0" /><mxPoint x="20" y="689.0" /></Array></mxGeometry></mxCell><mxCell id="train_m" parent="1" edge="1" source="train" target="m" value="" style="endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#79649b;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1419" y="689.0" /><mxPoint x="1419" y="239.0" /></Array></mxGeometry></mxCell><mxCell id="hist" parent="1" vertex="1" value="Text can also be counted" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontColor=#203747;"><mxGeometry x="45" y="581" width="255" height="45" as="geometry" /></mxCell><mxCell id="tr" parent="1" vertex="1" value="Training updates the matrix" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=16;fontColor=#203747;"><mxGeometry x="1140" y="581" width="255" height="45" as="geometry" /></mxCell><mxCell id="foot" parent="1" vertex="1" value="¹ A text embedding model uses a pooling or selection rule and a training objective suited to its task. See the next page for why the objective matters." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#203747;"><mxGeometry x="45" y="758" width="1350" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Why these concepts are connected" id="page2"><mxGraphModel page="1" pageWidth="1440" pageHeight="810" grid="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="Why these concepts are connected" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=35;fontColor=#203747;"><mxGeometry x="45" y="30" width="1340" height="55" as="geometry" /></mxCell><mxCell id="sub" parent="1" vertex="1" value="Each row asks what one representation preserves, what it loses, and which design decision follows." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#203747;"><mxGeometry x="45" y="92" width="1340" height="50" as="geometry" /></mxCell><mxCell id="r0c0" parent="1" vertex="1" value="&lt;b&gt;Choose the units&lt;/b&gt;&lt;br&gt;Whole words give short sequences but a finite&lt;br&gt;vocabulary can miss unfamiliar words." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="45" y="153" width="420" height="108" as="geometry" /></mxCell><mxCell id="r0c1" parent="1" vertex="1" value="&lt;b&gt;Mechanism&lt;/b&gt;&lt;br&gt;Bytes cover UTF-8 text with 256 possible byte&lt;br&gt;values, often at the cost of longer sequences." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="510" y="153" width="420" height="108" as="geometry" /></mxCell><mxCell id="r0c2" parent="1" vertex="1" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;Subword vocabularies reuse frequent pieces.&lt;br&gt;Coverage depends on the tokenizer and its fallback." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#eee7fa;strokeColor=#667d88;"><mxGeometry x="975" y="153" width="420" height="108" as="geometry" /></mxCell><mxCell id="r1c0" parent="1" vertex="1" value="&lt;b&gt;Preserve identity and order&lt;/b&gt;&lt;br&gt;Bag-of-words gives one count per vocabulary entry.&lt;br&gt;“Dogs chase cats” and “Cats chase dogs” can have&lt;br&gt;identical counts." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="45" y="278" width="420" height="108" as="geometry" /></mxCell><mxCell id="r1c1" parent="1" vertex="1" value="&lt;b&gt;Mechanism&lt;/b&gt;&lt;br&gt;A sequence of IDs retains order. Exchanging two IDs&lt;br&gt;changes the sequence. The numeric gap between IDs&lt;br&gt;has no inherent meaning." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="510" y="278" width="420" height="108" as="geometry" /></mxCell><mxCell id="r1c2" parent="1" vertex="1" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;A model needs the token-to-ID mapping it was&lt;br&gt;trained with. Special IDs can mark boundaries.&lt;br&gt;Models may share a tokenizer." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#eee7fa;strokeColor=#667d88;"><mxGeometry x="975" y="278" width="420" height="108" as="geometry" /></mxCell><mxCell id="r2c0" parent="1" vertex="1" value="&lt;b&gt;Learn from other examples&lt;/b&gt;&lt;br&gt;In 2003 Bengio and colleagues jointly learned word&lt;br&gt;vectors and a predictor. Shared features let&lt;br&gt;related examples inform predictions." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="45" y="403" width="420" height="108" as="geometry" /></mxCell><mxCell id="r2c1" parent="1" vertex="1" value="&lt;b&gt;Mechanism&lt;/b&gt;&lt;br&gt;During training, a loss measures prediction error.&lt;br&gt;Optimization adjusts embedding coordinates and&lt;br&gt;other model parameters." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="510" y="403" width="420" height="108" as="geometry" /></mxCell><mxCell id="r2c2" parent="1" vertex="1" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;During inference, each ID retrieves its stored row.&lt;br&gt;Which relationships appear in vector space depends&lt;br&gt;on the data and objective." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#eee7fa;strokeColor=#667d88;"><mxGeometry x="975" y="403" width="420" height="108" as="geometry" /></mxCell><mxCell id="r3c0" parent="1" vertex="1" value="&lt;b&gt;Choose the context&lt;/b&gt;&lt;br&gt;A single lookup vector cannot distinguish uses of&lt;br&gt;the same token. Surrounding tokens supply evidence&lt;br&gt;about each occurrence." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="45" y="528" width="420" height="108" as="geometry" /></mxCell><mxCell id="r3c1" parent="1" vertex="1" value="&lt;b&gt;Mechanism&lt;/b&gt;&lt;br&gt;A Transformer uses attention to combine information&lt;br&gt;from accessible positions. A causal mask allows&lt;br&gt;only the prefix at each position." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="510" y="528" width="420" height="108" as="geometry" /></mxCell><mxCell id="r3c2" parent="1" vertex="1" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;BERT (Devlin et al., 2019) uses context on both&lt;br&gt;sides. The model architecture determines which&lt;br&gt;clues can affect a token state." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#eee7fa;strokeColor=#667d88;"><mxGeometry x="975" y="528" width="420" height="108" as="geometry" /></mxCell><mxCell id="r4c0" parent="1" vertex="1" value="&lt;b&gt;Choose what to compare&lt;/b&gt;&lt;br&gt;A passage has many token states. To retrieve&lt;br&gt;passages efficiently, represent each passage with a&lt;br&gt;single vector." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="45" y="653" width="420" height="108" as="geometry" /></mxCell><mxCell id="r4c1" parent="1" vertex="1" value="&lt;b&gt;Mechanism&lt;/b&gt;&lt;br&gt;Pool states or select a designated state.&lt;br&gt;Similarity training can favor relevant&lt;br&gt;query–passage pairs over irrelevant pairs." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#ddf2ea;strokeColor=#667d88;"><mxGeometry x="510" y="653" width="420" height="108" as="geometry" /></mxCell><mxCell id="r4c2" parent="1" vertex="1" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;Cosine similarity compares vector directions.&lt;br&gt;Whether a high score means relevance, paraphrase,&lt;br&gt;or topic overlap depends on training." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#eee7fa;strokeColor=#667d88;"><mxGeometry x="975" y="653" width="420" height="108" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Rebuild and challenge the map" id="page3"><mxGraphModel page="1" pageWidth="1440" pageHeight="810" grid="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="Rebuild and challenge the map" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=35;fontColor=#203747;"><mxGeometry x="45" y="30" width="1340" height="55" as="geometry" /></mxCell><mxCell id="sub" parent="1" vertex="1" value="Start with a blank page and the diagram closed. Reopen the overview only after you have drawn your own explanation." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#203747;"><mxGeometry x="45" y="92" width="1340" height="50" as="geometry" /></mxCell><mxCell id="task0" parent="1" vertex="1" value="&lt;b&gt;Recall from scratch&lt;/b&gt;&lt;br&gt;Draw how text becomes useful to a model. Include a branch for generation&lt;br&gt;and a branch for retrieval. Give each arrow a verb." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="45" y="167" width="650" height="138" as="geometry" /></mxCell><mxCell id="task1" parent="1" vertex="1" value="&lt;b&gt;Locate one uncertainty&lt;/b&gt;&lt;br&gt;Circle the first arrow you could not explain. Write three questions about&lt;br&gt;its input, its operation and what could make your explanation fail." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="735" y="167" width="650" height="138" as="geometry" /></mxCell><mxCell id="task2" parent="1" vertex="1" value="&lt;b&gt;Predict before checking&lt;/b&gt;&lt;br&gt;If two vocabulary IDs are swapped only in the tokenizer, what changes?&lt;br&gt;What other rows or output mappings would need to move to preserve&lt;br&gt;behavior?" style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#fff1cc;strokeColor=#667d88;"><mxGeometry x="45" y="352" width="650" height="138" as="geometry" /></mxCell><mxCell id="task3" parent="1" vertex="1" value="&lt;b&gt;Try to break a claim&lt;/b&gt;&lt;br&gt;Find two texts with the same word counts and different meanings. Which&lt;br&gt;representation loses the distinction? Where could it be recovered?" style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#fff1cc;strokeColor=#667d88;"><mxGeometry x="735" y="352" width="650" height="138" as="geometry" /></mxCell><mxCell id="task4" parent="1" vertex="1" value="&lt;b&gt;Explain by analogy&lt;/b&gt;&lt;br&gt;Invent an analogy for the embedding lookup. Name two ways it breaks down&lt;br&gt;when explaining learning or contextualization." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="45" y="537" width="650" height="138" as="geometry" /></mxCell><mxCell id="task5" parent="1" vertex="1" value="&lt;b&gt;Review your strategy&lt;/b&gt;&lt;br&gt;Use the CSV’s 30–120 second struggle target on one missing link. At the&lt;br&gt;15-minute check, mark what you recalled, what you guessed and which arrow&lt;br&gt;to revisit." style="rounded=1;html=1;whiteSpace=wrap;spacing=6;align=center;verticalAlign=middle;fontSize=17;fontColor=#203747;fillColor=#e4effb;strokeColor=#667d88;"><mxGeometry x="735" y="537" width="650" height="138" as="geometry" /></mxCell><mxCell id="end" parent="1" vertex="1" value="Check against the overview. Redraw one corrected relationship from memory and explain what observation would change your answer." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#203747;"><mxGeometry x="45" y="730" width="1330" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>