<mxfile host="app.diagrams.net" type="device"><diagram id="tokens-and-embeddings" name="Tokens and embeddings"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="text_representation" value="Text representation&#xa;Turning text into numbers that&#xa;a model can compute with." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="230" height="59" as="geometry" /></mxCell><mxCell id="semantic_similarity" value="Semantic similarity&#xa;How close two meanings are,&#xa;measured as the distance&#xa;between their embeddings,&#xa;e.g. cosine similarity." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1320" y="100" width="230" height="89" as="geometry" /></mxCell><mxCell id="special_token" value="Special token&#xa;A reserved token with a role&#xa;instead of text: start of text,&#xa;end of text or padding." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="80" width="230" height="74" as="geometry" /></mxCell><mxCell id="embedding_method" value="Embedding method&#xa;A way of learning embeddings&#xa;from data." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="100" width="230" height="59" as="geometry" /></mxCell><mxCell id="word2vec" value="word2vec&#xa;Learns word embeddings by&#xa;training a small network to&#xa;predict whether two words&#xa;appear near each other." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1840" y="100" width="230" height="89" as="geometry" /></mxCell><mxCell id="bag_of_words" value="Bag-of-words&#xa;Represents a text by counting&#xa;how often each vocabulary word&#xa;appears in it." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="260" width="230" height="74" as="geometry" /></mxCell><mxCell id="bag_of_words_limitation" value="Bag-of-words limitation&#xa;Ignores word order and meaning;&#xa;vectors are large and mostly&#xa;zeros." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="260" width="230" height="74" as="geometry" /></mxCell><mxCell id="embedding" value="Embedding&#xa;A dense vector of numbers that&#xa;captures meaning: similar&#xa;meanings get nearby vectors." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1320" y="260" width="230" height="74" as="geometry" /></mxCell><mxCell id="text_embedding" value="Text embedding&#xa;One vector for a whole sentence&#xa;or document, used for search,&#xa;clustering and classification." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="260" width="230" height="74" as="geometry" /></mxCell><mxCell id="sentence_embedding_model" value="Sentence embedding model&#xa;A language model fine-tuned so&#xa;that texts with similar meaning&#xa;get nearby vectors." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1840" y="260" width="230" height="74" as="geometry" /></mxCell><mxCell id="tokenizer" value="Tokenizer&#xa;Splits text into tokens and&#xa;maps each token to its ID;&#xa;each model has its own." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="230" height="74" as="geometry" /></mxCell><mxCell id="tokenization" value="Tokenization&#xa;Splitting text into tokens, the&#xa;units a language model reads." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="460" width="230" height="59" as="geometry" /></mxCell><mxCell id="token" value="Token&#xa;One unit of text: a word, part&#xa;of a word, a character or a&#xa;byte." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="460" width="230" height="74" as="geometry" /></mxCell><mxCell id="token_id" value="Token ID&#xa;A token's number in the&#xa;vocabulary; the model receives&#xa;a sequence of IDs, not text." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="460" width="230" height="74" as="geometry" /></mxCell><mxCell id="language_model" value="Language model&#xa;A model that reads token IDs&#xa;and predicts tokens, usually&#xa;the next one." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1060" y="460" width="230" height="74" as="geometry" /></mxCell><mxCell id="token_embedding" value="Token embedding&#xa;The vector the model stores for&#xa;one vocabulary token, learned&#xa;during training." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1320" y="460" width="230" height="74" as="geometry" /></mxCell><mxCell id="contextualized_embedding" value="Contextualized embedding&#xa;A token's vector after the model&#xa;has read the surrounding text;&#xa;the same word gets different&#xa;vectors in different sentences." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="460" width="230" height="89" as="geometry" /></mxCell><mxCell id="vocabulary" value="Vocabulary&#xa;The fixed set of tokens a&#xa;tokenizer knows, each with a&#xa;unique ID; its size is chosen&#xa;before training." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="230" height="89" as="geometry" /></mxCell><mxCell id="word_tokenization" value="Word tokenization&#xa;Splits text into whole words;&#xa;words not in the vocabulary&#xa;become an unknown token." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="680" width="230" height="74" as="geometry" /></mxCell><mxCell id="subword_tokenization" value="Sub-word tokenization&#xa;Splits rare words into known&#xa;pieces, so a modest vocabulary&#xa;covers any word; used by most&#xa;LLMs." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="680" width="230" height="89" as="geometry" /></mxCell><mxCell id="character_tokenization" value="Character tokenization&#xa;One token per character: covers&#xa;any word but makes sequences&#xa;long." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="680" width="230" height="74" as="geometry" /></mxCell><mxCell id="byte_tokenization" value="Byte tokenization&#xa;One token per byte of the UTF-8&#xa;encoding: covers every language&#xa;and symbol." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1060" y="680" width="230" height="74" as="geometry" /></mxCell><mxCell id="embedding_matrix" value="Embedding matrix&#xa;The model's table of token&#xa;embeddings, one row per&#xa;vocabulary token." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1320" y="680" width="230" height="74" as="geometry" /></mxCell><mxCell id="byte_pair_encoding" value="Byte pair encoding&#xa;Builds the vocabulary by&#xa;repeatedly merging the most&#xa;frequent pair of symbols into&#xa;a new token." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="900" width="230" height="89" as="geometry" /></mxCell><mxCell id="wordpiece" value="WordPiece&#xa;Sub-word method used by BERT;&#xa;merges the pairs that most&#xa;increase the likelihood of the&#xa;training text." style="rounded=1;html=0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="900" width="230" height="89" as="geometry" /></mxCell><mxCell id="question_tokenizer" value="Why can't a model use another model's tokenizer?" style="rounded=1;html=0;align=center;verticalAlign=middle;fontSize=12;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="350" height="40" as="geometry" /></mxCell><mxCell id="question_similarity" value="Can close embeddings differ in meaning?" style="rounded=1;html=0;align=center;verticalAlign=middle;fontSize=12;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1290" y="20" width="290" height="40" as="geometry" /></mxCell><mxCell id="question_context" value="How does context change a token's embedding?" style="rounded=1;html=0;align=center;verticalAlign=middle;fontSize=12;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1840" y="485" width="310" height="40" as="geometry" /></mxCell><mxCell id="question_subword" value="Why do LLMs prefer sub-word tokens?" style="rounded=1;html=0;align=center;verticalAlign=middle;fontSize=12;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="280" y="925" width="250" height="40" as="geometry" /></mxCell><mxCell id="relationship_1" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bag_of_words" target="text_representation"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_2" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="embedding" target="text_representation"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_3" value="has" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bag_of_words" target="bag_of_words_limitation"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_4" value="solves" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="embedding" target="bag_of_words_limitation"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_5" value="enables" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="embedding" target="semantic_similarity"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_6" value="uses" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bag_of_words" target="tokenization"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_7" value="performs" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tokenizer" target="tokenization"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_8" value="produces" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tokenization" target="token"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_9" value="has" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="token" target="token_id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_10" value="has" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tokenizer" target="vocabulary"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_11" value="contains" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="vocabulary" target="token"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_12" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="special_token" target="token"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_13" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="word_tokenization" target="tokenization"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_14" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="subword_tokenization" target="tokenization"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_15" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.75;entryY=1;" edge="1" parent="1" source="character_tokenization" target="tokenization"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_16" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="byte_tokenization" target="tokenization"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_17" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="byte_pair_encoding" target="subword_tokenization"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_18" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wordpiece" target="subword_tokenization"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_19" value="reads" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="language_model" target="token_id"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_20" value="uses" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=0;entryX=0.85;entryY=0;" edge="1" parent="1" source="language_model" target="tokenizer"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1175" y="400" /><mxPoint x="215" y="400" /></Array></mxGeometry></mxCell><mxCell id="relationship_21" value="contains" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="language_model" target="embedding_matrix"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_22" value="selects-row-in" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="token_id" target="embedding_matrix"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_23" value="contains" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="embedding_matrix" target="token_embedding"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_24" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="token_embedding" target="embedding"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_25" value="produces" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="language_model" target="contextualized_embedding"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1175" y="615" /><mxPoint x="1695" y="615" /></Array></mxGeometry></mxCell><mxCell id="relationship_26" value="starts-from" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contextualized_embedding" target="token_embedding"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_27" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="contextualized_embedding" target="embedding"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_28" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="text_embedding" target="embedding"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_29" value="produces" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sentence_embedding_model" target="text_embedding"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_30" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sentence_embedding_model" target="embedding_method"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_31" value="is-a" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="word2vec" target="embedding_method"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="relationship_32" value="produces" style="html=0;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="embedding_method" target="embedding"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="attach_question_tokenizer" value="" style="html=0;endArrow=open;dashed=1;strokeColor=#b59a3a;" edge="1" parent="1" source="question_tokenizer" target="tokenizer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="attach_question_similarity" value="" style="html=0;endArrow=open;dashed=1;strokeColor=#b59a3a;" edge="1" parent="1" source="question_similarity" target="semantic_similarity"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="attach_question_context" value="" style="html=0;endArrow=open;dashed=1;strokeColor=#b59a3a;" edge="1" parent="1" source="question_context" target="contextualized_embedding"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="attach_question_subword" value="" style="html=0;endArrow=open;dashed=1;strokeColor=#b59a3a;" edge="1" parent="1" source="question_subword" target="subword_tokenization"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
